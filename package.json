    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "openai": "^7.65.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
