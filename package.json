{
  "name": "agentic-publishing-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Step 1: OpenAI Responses API function calling with a local mock article lookup.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js",
      "default": "./dist/engine.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
