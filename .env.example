# Copy this file to .env and fill in your own key.
# .env is gitignored. Do not commit a real key.
#
# OPENAI_BASE_URL is optional.
# Leave it unset for the official OpenAI API.
# Set it to use an OpenAI-compatible host such as OpenRouter.
# The program does not choose a different model if a request fails.

# Official OpenAI API
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-6.2-astra

# OpenRouter
# OPENAI_API_KEY=replace-me
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-4o-mini

# Blog API. Used only with `npm start -- --target live`. The default target is mock,
# which keeps drafts in memory and does not call the blog.
# BLOG_API_URL is the GraphQL endpoint. AGENT_API_SECRET is sent only as
# X-Agent-Authorization from this process. It must be at least 32 characters and
# must differ from the blog editor secret. Do not commit the real value.
# BLOG_API_URL=https://your-service.onrender.com/graphql
# AGENT_API_SECRET=replace-me
