# Copy this file to .env and fill in your own key.
# .env is gitignored. Do not commit a real key.
#
# OPENAI_BASE_URL is optional.
# Leave it unset for the official OpenAI API.
# Set it to use an OpenAI-compatible host such as OpenRouter.
# The program does not choose a different model if a request fails.

# Official OpenAI API
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-6.2-astra

# OpenRouter
# OPENAI_API_KEY=replace-me
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-4o-mini
